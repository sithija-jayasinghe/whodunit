{
  "name": "whodunit",
  "version": "0.1.1",
  "description": "Find which single change broke your test. Splits a diff into hunks and delta-debugs them against a failing test until it proves the culprit. CLI and MCP server.",
  "license": "MIT",
  "author": "Sithija Jayasinghe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sithija-jayasinghe/whodunit.git"
  },
  "homepage": "https://github.com/sithija-jayasinghe/whodunit#readme",
  "bugs": {
    "url": "https://github.com/sithija-jayasinghe/whodunit/issues"
  },
  "type": "module",
  "bin": {
    "whodunit": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "debugging",
    "delta-debugging",
    "ddmin",
    "bisect",
    "git",
    "testing",
    "regression",
    "ai",
    "agent",
    "mcp",
    "mcp-server"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
